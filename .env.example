ENVIRONMENT=development
SECRET_KEY=yoursecretkeythatneedstobe32long!
BASE_URL=http://localhost:8000

MAX_API_URL=https://api.max.ru/v1
MAX_BOT_TOKEN=your_token
MAX_CHAT_ID=123456

# AMOCRM
AMOCRM_SUBDOMAIN=company
AMOCRM_CLIENT_ID=xxx
AMOCRM_CLIENT_SECRET=xxx
AMOCRM_LONG_TERM_TOKEN=your_token
AMOCRM_PIPELINE_ID=123456
AMOCRM_STATUS_ID=654321
# Кастомные поля
AMOCRM_FORM_TYPE_FIELD_ID=123456
AMOCRM_PHONE_FIELD_ID=0
AMOCRM_EMAIL_FIELD_ID=0
AMOCRM_NAME_FIELD_ID=0
AMOCRM_TAG_ID=0  # ID тега "Запрос с лендинга", получить через API (GET /api/v4/leads/tags)

RECAPTCHA_SECRET_KEY=xxx
RATELIMIT_DEFAULT=5/minute
# Путь к томам с данными (SQLite, логи, загрузки). 
# По умолчанию ./data для локальной разработки, /data на Amvera.
DATA_DIR=./data

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
LOG_LEVEL=INFO
LOG_FILE_PATH=./data/logs

# Папка для загруженных файлов: {DATA_DIR}/uploads (создается автоматически)

# Email notifications
MAIL_TO=prombez@egpb.ru
MAIL_FROM=noreply@ваш-sandbox-домен.unigosendbox.com
SMTP_HOST=smtp.go2.unisender.ru
SMTP_PORT=587
SMTP_USER=ваш_user_id
SMTP_PASSWORD=ваш_api_key
